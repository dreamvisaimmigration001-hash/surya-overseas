# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail Nodemailer Configuration
# 1. GMAIL_USER: Your Gmail or Google Workspace email address (e.g. consult@suryaoverseas.com or example@gmail.com)
GMAIL_USER=""

# 2. GMAIL_APP_PASSWORD: 16-character Google App Password (not your personal account password)
# Generate from: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_APP_PASSWORD=""

# 3. CONTACT_RECEIVER_EMAIL: (Optional) The email where consultation inquiries should be sent. Defaults to GMAIL_USER.
CONTACT_RECEIVER_EMAIL=""

